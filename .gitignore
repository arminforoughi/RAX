# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual envs
.venv*/
venv/

# Caches
.cache/

# Model weights / large artifacts (download separately, do not commit)
weights/
*.pt
*.pth
*.onnx

# Media
*.mp4
*.mov
*.avi

# Credentials — never commit
.env.local
.env.*.local

# OS
.DS_Store

# RAX runtime state & logs (machine-specific, regenerated at runtime)
stack_mission2_stdout.log
stack_mission2_stdout.log.err
supervise.log
camserver_stdout.log*
handeye_tf.json*
floor_plane.json
guest_log.jsonl
feedback.jsonl
guest_qr.png
_camview.jpg
fpv_*.log
*_stdout.log
*_stderr.log
sm2_supervisor.log

# Derived per-arm calibration. Regenerated by manipulation.arms.workspace.analyze_workspace;
# machine- and URDF-specific, so it is a build product rather than source. The committed
# so101_workspace.json is kept as a reference sample.
*_workspace.json
!so101_workspace.json

# --- publishing hygiene -------------------------------------------------------
# Build artifacts
build/
dist/
*.egg-info/

# Per-rig calibration: measured on ONE robot, meaningless on another. Each of these
# has a committed .example counterpart showing the format; the real one is a local
# measurement, not source. Committing them is how a stranger silently inherits
# somebody else's hand-eye transform and wonders why the arm misses.
handeye_tf*.json
floor_plane.json
*_workspace.json
!*.example.json
!so101_workspace.json

# Scratch and session state
outputs/
_camview.jpg
guest_qr.png
*.jsonl

# Working files from launching the demo server detached
.server_stdin.txt
.mission_server.pid

# Rotated server logs (mission_server_stdout.log.err, .prev2, ...) and the
# stdin-priming file the detached launcher uses. All machine-local runtime state.
mission_server_stdout.log*
mission_server_stderr*.log
*.log.err*
*.prev[0-9]*.log
.calib_enter.txt

mission_server_stdout.prev.log
