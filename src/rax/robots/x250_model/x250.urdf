<?xml version="1.0"?>
<!--
  X250 (WidowX-250-class, 5 DoF + parallel gripper) — a KINEMATIC SKETCH, not a
  vendor URDF.

  READ THIS BEFORE TRUSTING A NUMBER IN IT.

  There is no X250 URDF on this rig and none in this repo: no Interbotix ROS install,
  nothing in site-packages, no meshes. So this file was WRITTEN, and it separates two
  very different kinds of number.

  WHAT IS MEASURED, and can be relied on:
    * the joint STRUCTURE — base yaw, three parallel pitches, a tool roll, then the
      jaws. That comes from the arm itself: a broadcast ping found ids 2..7, and
      `x250_driver.MOTOR_IDS` names them base / shoulder_2 / elbow / wrist / tool /
      gripper. Five actuated joints to the hand, in that order.
    * the joint TRAVEL. Each <limit> below is the arm's own calibrated tick range
      (~/.cache/huggingface/lerobot/calibration/robots/x250_follower.json) converted
      at 360deg/4096 ticks. See x250/normalise.py, which is the one place that
      conversion lives.

  WHAT IS NOMINAL, and is NOT a measurement of this arm:
    * every <origin xyz> — i.e. every LINK LENGTH. These are plausible figures for a
      250-class arm, chosen so the rendered arm has roughly the right proportions and
      roughly the right reach. Nobody has put a ruler on this robot.
    * therefore the absolute scale of the 3D view, and any reach number derived from
      it.

  WHAT THAT MEANS IN PRACTICE. The rendered arm moves CORRECTLY — the base swings the
  right way, the elbow folds the right way, the hand arrives from the right bearing —
  because motion direction comes from the axes and the travel, both of which are real.
  What is approximate is how LONG each segment is drawn. So use this view to watch an
  approach happen; do not use it to decide whether something is in reach.

  TO CORRECT IT, replace the xyz values with tape-measure distances between joint
  axes (they are all easy to reach on this arm), or drop the genuine Interbotix URDF
  into this directory and repoint `urdf=` in profiles/x250.py at it — the profile is
  the only thing that names this file.

  CONVENTIONS, matching the SO-101 URDF next door: X forward, Y left, Z up, metres
  and radians, <origin rpy> extrinsic X-Y-Z. At the all-zero pose the upper arm
  stands straight up and the forearm reaches forward, which is the Interbotix zero.

  VISUALS ARE PRIMITIVES (box / cylinder), deliberately. The viewer tessellates them
  (robots/urdf_visuals.py), so the 3D view needs no STL files that do not exist. A
  real mesh URDF drops in without changing the viewer.
-->
<robot name="x250">

  <!-- ============================ links ============================ -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0395" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.079"/></geometry>
      <material name="x250_dark"><color rgba="0.29 0.31 0.35 1"/></material>
    </visual>
  </link>

  <!-- The yaw turret. Drawn as the shoulder axis housing, lying along Y. -->
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.020" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.042" length="0.062"/></geometry>
      <material name="x250_body"><color rgba="0.39 0.47 0.60 1"/></material>
    </visual>
  </link>

  <!-- Upper arm: stands up from the shoulder at the zero pose. -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.025 0 0.125" rpy="0 0 0"/>
      <geometry><box size="0.062 0.070 0.250"/></geometry>
      <material name="x250_body"/>
    </visual>
  </link>

  <!-- Forearm: reaches forward from the elbow at the zero pose. -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0.0875 0 0" rpy="0 0 0"/>
      <geometry><box size="0.175 0.058 0.058"/></geometry>
      <material name="x250_body"/>
    </visual>
  </link>

  <link name="wrist_link">
    <visual>
      <origin xyz="0.0375 0 0" rpy="0 0 0"/>
      <geometry><box size="0.075 0.050 0.050"/></geometry>
      <material name="x250_body"/>
    </visual>
  </link>

  <!-- The roll body the jaws hang off. -->
  <link name="gripper_link">
    <visual>
      <origin xyz="0.030 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.031" length="0.060"/></geometry>
      <material name="x250_hand"><color rgba="0.74 0.78 0.84 1"/></material>
    </visual>
  </link>

  <!-- The grasp centre: the frame the pick aims at. No visual of its own; the jaws
       below straddle it, which is the whole point of putting it between them. -->
  <link name="gripper_frame_link"/>

  <!-- The two jaws. NOT on the chain to gripper_frame_link, so forward kinematics
       ignores them and the viewer poses them from gripper_link by hand — exactly as
       the SO-101 viewer already does for its moving jaw (see JAW_T there). -->
  <link name="left_finger_link">
    <visual>
      <origin xyz="0.024 0 0" rpy="0 0 0"/>
      <geometry><box size="0.048 0.010 0.028"/></geometry>
      <material name="x250_hand"/>
    </visual>
  </link>
  <link name="right_finger_link">
    <visual>
      <origin xyz="0.024 0 0" rpy="0 0 0"/>
      <geometry><box size="0.048 0.010 0.028"/></geometry>
      <material name="x250_hand"/>
    </visual>
  </link>

  <!-- ============================ joints ============================ -->
  <!-- Every <limit> is this arm's OWN calibrated travel (its tick range at 360/4096 deg
       per tick), EXPRESSED ABOUT THIS URDF'S ZERO. That second clause is load-bearing
       and was got wrong once: the limits were first written symmetric, as plus or minus
       half the travel, which is only correct if the URDF zero sits at the centre of the
       calibrated range. It does NOT. x250/normalise.ZERO_NORM offsets it, fitted to the
       demonstrated grasp pose, so the window is asymmetric; writing it symmetric put the
       demonstrated shoulder_2 envelope 9.6 deg OUTSIDE the travel the arm supposedly had.
       So: THE LIMITS AND ZERO_NORM ARE COUPLED. Regenerate these whenever ZERO_NORM
       changes; a test pins the relationship so it cannot drift silently.
       Rounded OUTWARD, because rounding a limit inward clamps away travel the arm
       really has.
       The demonstrated SAFE box is much tighter than any of this and is carried by the
       PROFILE (safe_envelope.json), not by this file. -->

  <joint name="base" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.079" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- 0..4095 ticks: the UNRANGED Dynamixel default, so this is 'a full turn' and
         means nobody has ranged this joint. -->
    <limit lower="-3.059165" upper="3.222488" effort="10" velocity="3.0"/>
  </joint>

  <joint name="shoulder_2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.040" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- 2181 ticks = 191.69 deg of travel, measured. -->
    <limit lower="-1.840924" upper="1.504690" effort="10" velocity="3.0"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.050 0 0.250" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- 1226 ticks = 107.75 deg of travel, measured. -->
    <limit lower="-0.944656" upper="0.936005" effort="10" velocity="3.0"/>
  </joint>

  <joint name="wrist" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.175 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- 0..4095 ticks: the UNRANGED Dynamixel default, as with base. -->
    <limit lower="-1.641396" upper="4.640256" effort="10" velocity="3.0"/>
  </joint>

  <joint name="tool" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="0.075 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <!-- 2461 ticks = 216.30 deg of travel, measured. -->
    <limit lower="-2.622260" upper="1.152868" effort="10" velocity="3.0"/>
  </joint>

  <joint name="ee_fixed" type="fixed">
    <parent link="gripper_link"/>
    <child link="gripper_frame_link"/>
    <origin xyz="0.080 0 0" rpy="0 0 0"/>
  </joint>

  <!-- The jaws open along the hand's Y. `gripper` is one actuator driving both, so
       the right finger MIRRORS it; the viewer applies the same displacement with the
       sign flipped rather than pretending there are two motors. -->
  <joint name="gripper_left" type="prismatic">
    <parent link="gripper_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0.050 0.013 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.022" effort="10" velocity="0.2"/>
  </joint>
  <joint name="gripper_right" type="prismatic">
    <parent link="gripper_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0.050 -0.013 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.022" effort="10" velocity="0.2"/>
  </joint>

</robot>
