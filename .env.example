# RAX Evolve — self-learning robot stack environment

# Robot control layer (stack_mission2.py must already be running here)
ROBOT_BASE_URL=http://localhost:8484
SELF_PORT=8686

# Band AI — multi-agent coordination (optional but recommended for judging)
BAND_API_KEY=
BAND_AGENT_ID=
BAND_ROOM_ID=
BAND_API_URL=https://api.band.ai

# Actian VectorAI DB — semantic episodic memory
ACTIAN_HOST=localhost:6574
ACTIAN_COLLECTION=rax_memory

# Pioneer AI — adaptive inference / fine-tuned specialist
PIONEER_API_KEY=
PIONEER_API_URL=https://api.pioneer.ai/v1
PIONEER_TRAIN_URL=https://api.pioneer.ai
PIONEER_MODEL=fastino/qwen3-32b
